{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        }
      ]
    },
    {
      "source": "/references/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/notizen/weg-von-macos/",
      "destination": "/notizen/macos-verlassen-imac-2013/",
      "permanent": true
    },
    {
      "source": "/en/notes/weg-von-macos/",
      "destination": "/en/notes/macos-verlassen-imac-2013/",
      "permanent": true
    },
    {
      "source": "/ru/notes/weg-von-macos/",
      "destination": "/ru/notes/macos-verlassen-imac-2013/",
      "permanent": true
    },
    {
      "source": "/ua/notes/weg-von-macos/",
      "destination": "/ua/notes/macos-verlassen-imac-2013/",
      "permanent": true
    }
  ]
}
